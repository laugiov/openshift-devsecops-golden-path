        "hide": 0,
        "includeAll": true,
        "label": "Application",
        "multi": true,
        "name": "app",
        "query": {
          "query": "label_values(ci_pipeline_status, app)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
